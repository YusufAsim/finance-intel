# django runtime
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_LOG_LEVEL=INFO
# database connection, host matches the compose service name
DATABASE_URL=postgres://finance:change-me@postgres:5432/finance
# cross origin access for the vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
# downstream services
ML_BASE_URL=http://ml:8000
ML_TIMEOUT_SECONDS=10
# directory holding generator output, mounted read only
DATA_DIR=/data/out
